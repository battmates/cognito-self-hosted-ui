APP_NAME="RSL Group Auth"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

COGNITO_REGION=eu-west-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_AUTH_FLOW=USER_PASSWORD_AUTH
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI="${APP_URL}/callback"
COGNITO_LOGOUT_URI="${APP_URL}/logout"
COGNITO_SCOPES="openid email profile"

# The broker uses this single existing Cognito client for all enabled consumers.
SSO_STATE_TTL_SECONDS=900
SSO_CLAIM_ROLES="custom:user_role,custom:user_type,cognito:groups"

SSO_GUESTLIST_URL=https://staging.guestlist.rockschool.io
SSO_GUESTLIST_CALLBACK_URLS=https://staging.guestlist.rockschool.io/cognito/callback
SSO_GUESTLIST_LOGOUT_URLS=https://staging.guestlist.rockschool.io/logout
SSO_BACKSTAGE_URL=https://staging.rockschool.io
SSO_BACKSTAGE_CALLBACK_URLS=https://staging.rockschool.io/cognito-login
SSO_BACKSTAGE_LOGOUT_URLS=https://staging.rockschool.io/logout
# Add these only after auditing their client/token expectations and staging URLs.
SSO_CLOUD_URL=
SSO_CLOUD_CALLBACK_URLS=
SSO_CLOUD_LOGOUT_URLS=
SSO_MUSICTEACHER_URL=
SSO_MUSICTEACHER_CALLBACK_URLS=
SSO_MUSICTEACHER_LOGOUT_URLS=
SSO_SPOTLIGHT_URL=
SSO_SPOTLIGHT_CALLBACK_URLS=
SSO_SPOTLIGHT_LOGOUT_URLS=

# Only Google is currently enabled in the staging Cognito client.
COGNITO_SOCIAL_GOOGLE_ENABLED=true
COGNITO_SOCIAL_MICROSOFT_ENABLED=false
COGNITO_MICROSOFT_PROVIDER_NAME=Microsoft
COGNITO_SOCIAL_FACEBOOK_ENABLED=false
COGNITO_SOCIAL_APPLE_ENABLED=false
# Federation credentials stay in Cognito; this portal uses its client ID/secret above.

COGNITO_ADMIN_ROLE_ATTRIBUTES="custom:user_role,custom:user_type"
COGNITO_MANAGEMENT_WRITES_ENABLED=true
AWS_SESSION_TOKEN=

# Proposed HTTPS verification adapters; leave disabled until approved and tested.
LEGACY_MIGRATION_ENABLED=false
MIGRATION_WORDPRESS_ENABLED=false
MIGRATION_WORDPRESS_ENDPOINT=
MIGRATION_WORDPRESS_API_TOKEN=
MIGRATION_CLOUD_ENABLED=false
MIGRATION_CLOUD_ENDPOINT=
MIGRATION_CLOUD_API_TOKEN=

# Read-only SES reporting for the staging Cognito mail source.
SES_REPORTING_REGION=eu-west-2
SES_REPORTING_CONFIGURATION_SET=SES-Config-Set
SES_REPORTING_FROM_ADDRESS=login@rslgroup.io
